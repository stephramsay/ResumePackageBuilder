{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Resume Package Content",
  "type": "object",
  "required": [
    "metadata",
    "positioning",
    "selected_claim_ids",
    "selected_metric_ids",
    "resume",
    "cover_letter",
    "operating_work",
    "leadership_style"
  ],
  "additionalProperties": true,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["company", "role_title", "slug", "public_url"],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "role_title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "generated_on": { "type": "string" },
        "target_role_label": { "type": "string" },
        "public_url": { "type": "string", "format": "uri" }
      }
    },
    "positioning": {
      "type": "object",
      "required": ["eyebrow", "hero_subtitle", "resume_headline", "side_panel_summary", "side_panel_signals", "role_fit_thesis"],
      "properties": {
        "eyebrow": { "type": "string" },
        "hero_subtitle": { "type": "string" },
        "resume_headline": { "type": "string" },
        "side_panel_summary": { "type": "string" },
        "side_panel_signals": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "role_fit_thesis": { "type": "string" },
        "concern_to_address": { "type": "string" }
      }
    },
    "selected_claim_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "selected_metric_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "text"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "resume": {
      "type": "object",
      "required": ["summary", "roles", "skills", "education_ids"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role_id", "employer", "location", "dates", "title", "claims"],
            "properties": {
              "role_id": { "type": "string" },
              "employer": { "type": "string" },
              "location": { "type": "string" },
              "dates": { "type": "string" },
              "title": { "type": "string" },
              "descriptor": { "type": "string" },
              "subroles": { "type": "array" },
              "claims": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "education_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cover_letter": {
      "type": "object",
      "required": ["target_title", "date", "company", "greeting", "paragraphs", "closing"],
      "properties": {
        "target_title": { "type": "string" },
        "date": { "type": "string" },
        "company": { "type": "string" },
        "department": { "type": "string" },
        "company_location": { "type": "string" },
        "greeting": { "type": "string" },
        "paragraphs": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "closing": { "type": "string" }
      }
    },
    "operating_work": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "properties": {
          "title": { "type": "string" },
          "variant": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "leadership_style": { "type": "object" }
  }
}
